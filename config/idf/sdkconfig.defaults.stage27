# Stage27 native BLE input build overlay.
# ESP32-S3 uses the NimBLE BLE-only host. ESP-IDF 5.5 no longer exposes the
# legacy BTDM_CTRL_MODE_* choices for this target; keep only supported host
# selections so sdkconfig generation is warning-free.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y

# Stage27C hardware diagnostics are emitted with ESP_LOGI. Keep INFO compiled in for physical bring-up.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Stage27 log files deliberately use 8.3 names; metadata lives in the session record.
# Avoid heap-backed long-filename state in the firmware.
CONFIG_FATFS_LFN_NONE=y
# CONFIG_FATFS_LFN_HEAP is not set
