# Stage27 native BLE input build overlay.
# Match the ESP-IDF v5.5.4 NimBLE BLE-only host configuration used by the official blecent example.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y

# Stage27C hardware diagnostics are emitted with ESP_LOGI. Keep INFO compiled in for physical bring-up.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
