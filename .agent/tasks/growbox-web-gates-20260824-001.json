{
  "id": "growbox-web-gates-20260824-001",
  "mode": "commands",
  "work_branch": "integration/convergence-2026-08",
  "allow_write": false,
  "command_timeout": 900,
  "idle_timeout": 300,
  "task_timeout": 1800,
  "memory_limit_mb": 4096,
  "steps": [
    {
      "name": "web-toolchain",
      "command": "node --version && corepack pnpm --version",
      "timeout": 60
    },
    {
      "name": "web-install",
      "command": "corepack pnpm --dir web install --frozen-lockfile",
      "timeout": 600
    },
    {
      "name": "web-typecheck",
      "command": "corepack pnpm --dir web typecheck",
      "timeout": 300
    },
    {
      "name": "web-lint",
      "command": "corepack pnpm --dir web lint",
      "timeout": 300
    },
    {
      "name": "web-test",
      "command": "corepack pnpm --dir web test -- --run",
      "timeout": 300
    },
    {
      "name": "web-build",
      "command": "corepack pnpm --dir web build",
      "timeout": 300
    }
  ]
}
