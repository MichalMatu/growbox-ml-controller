{
  "id": "20260914-precommit-apply-v1",
  "agent_binding": "815cf40f-8d2a-4e1f-b7cc-c0f4e37b6cb5",
  "mode": "commands",
  "work_branch": "main",
  "allow_write": true,
  "resources": [],
  "memory_limit_mb": 4096,
  "command_timeout": 900,
  "task_timeout": 1200,
  "commands": [
    "git fetch --prune origin && git rev-parse HEAD && git status --short",
    "/opt/homebrew/bin/pre-commit run --all-files",
    "git status --short && git diff --check"
  ]
}
